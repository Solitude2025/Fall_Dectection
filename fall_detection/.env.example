# Optional database settings for the Spring Boot service.
# Copy to your shell environment or a local .env file; never commit real secrets.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fall_detection
MYSQL_USER=fall_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Set to h2 to use a local file database when MySQL is unavailable.
# SPRING_PROFILES_ACTIVE=h2
